// Trecho para colar no módulo topo (Mod_Teste_RiscV.sv).
// Ajuste os nomes das portas do RegisterFile e da ULA conforme a Sprint 5.

logic [31:0] w_PC, w_PCp4, w_Inst, w_Imm;
logic [31:0] w_rd1SrcA, w_rd2, w_SrcB, w_ULAResult;
logic [2:0]  w_ULAControl;
logic        w_ULASrc, w_RegWrite;
logic        w_Z;

// PC + 4
assign w_PCp4 = w_PC + 32'd4;

PC pc_inst (
    .clk (clk),
    .rst (rst),
    .PCin(w_PCp4),
    .PC  (w_PC)
);

InstrMem #(.ADDR_W(10)) im_inst (
    .A (w_PC[9:0]),
    .RD(w_Inst)
);

ControlUnit cu_inst (
    .Op        (w_Inst[6:0]),
    .Funct3    (w_Inst[14:12]),
    .Funct7    (w_Inst[31:25]),
    .ULAControl(w_ULAControl),
    .ULASrc    (w_ULASrc),
    .RegWrite  (w_RegWrite)
);

Extend ext_inst (
    .Imm12(w_Inst[31:20]),
    .Imm32(w_Imm)
);

// MuxULASrc
assign w_SrcB = w_ULASrc ? w_Imm : w_rd2;

RegisterFile rf_inst (
    .clk(clk),
    .rst(rst),
    .we3(w_RegWrite),
    .ra1(w_Inst[19:15]),
    .ra2(w_Inst[24:20]),
    .wa3(w_Inst[11:7]),
    .wd3(w_ULAResult),
    .rd1(w_rd1SrcA),
    .rd2(w_rd2),
    // saídas de debug
    .x0(w_d0x0), .x1(w_d0x1), .x2(w_d0x2), .x3(w_d0x3),
    .x4(w_d1x0), .x5(w_d1x1), .x6(w_d1x2), .x7(w_d1x3)
);

ULA ula_inst (
    .SrcA      (w_rd1SrcA),
    .SrcB      (w_SrcB),
    .ULAControl(w_ULAControl),
    .ULAResult (w_ULAResult),
    .Z         (w_Z)
);

// Debug na placa
assign w_d0x4 = w_PC;                                   // PC no LCD
assign LEDR[4:0] = {w_RegWrite, w_ULASrc, w_ULAControl}; // sinais de controle
// HEX0-HEX7 <- w_Inst (use o seu decodificador de 7 segmentos)
