// Unidade de controle - decodificador combinacional (Tabela 3)
module ControlUnit (
    input  logic [6:0] Op,
    input  logic [2:0] Funct3,
    input  logic [6:0] Funct7,
    output logic [2:0] ULAControl,
    output logic       ULASrc,
    output logic       RegWrite
);

    always_comb begin
        // default: instrução não reconhecida não altera nada
        RegWrite   = 1'b0;
        ULASrc     = 1'b0;
        ULAControl = 3'b000;

        case (Op)
            // tipo R
            7'b0110011: begin
                RegWrite = 1'b1;
                case ({Funct7, Funct3})
                    10'b0000000_000: ULAControl = 3'b000; // add
                    10'b0100000_000: ULAControl = 3'b001; // sub
                    10'b0000000_111: ULAControl = 3'b010; // and
                    10'b0000000_110: ULAControl = 3'b011; // or
                    10'b0000000_010: ULAControl = 3'b101; // slt
                    default:         RegWrite   = 1'b0;
                endcase
            end

            // tipo I (só addi por enquanto)
            7'b0010011: begin
                if (Funct3 == 3'b000) begin
                    RegWrite   = 1'b1;
                    ULASrc     = 1'b1;
                    ULAControl = 3'b000;
                end
            end

            default: ;
        endcase
    end

endmodule
