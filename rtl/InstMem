// Memória de instruções (ROM combinacional)
// Endereçamento em bytes, palavras de 32 bits: cada instrução ocupa 4 endereços.
// ADDR_W pode ir de 10 a 32 bits (cuidado: valores altos não cabem no FPGA).
module InstMem #(
    parameter ADDR_W = 10,
    parameter ARQUIVO = "program.hex"
)(
    input  logic [ADDR_W-1:0] A,
    output logic [31:0]       RD
);

    // como os 2 bits de baixo são sempre 00, indexa só por palavra
    logic [31:0] rom [0:(2**(ADDR_W-2))-1];

    initial begin
        for (int i = 0; i < 2**(ADDR_W-2); i++)
            rom[i] = 32'h0;
        $readmemh(ARQUIVO, rom);
    end

    assign RD = rom[A[ADDR_W-1:2]];

endmodule
